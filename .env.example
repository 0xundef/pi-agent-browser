# Local dev: copy to `.env` and/or use `.env.local` (both gitignored). Loaded on startup;
# variables already set in the environment (e.g. CI / PM2 / GitHub Actions) are not overwritten.
#
# Deploy: API keys → GitHub **Secrets** (e.g. ANTHROPIC_AUTH_TOKEN). Non-secrets → **Variables**:
# DEPLOY_PATH, EXTENSION_STORAGE_ROOT, AGENT_QUEUE_ROOT, TASK_TIMEOUT_MS, TASK_FINALIZE_TIMEOUT_MS, BROWSER_GUARD_CLOSE_ALL_BEFORE_OPEN,
# AGENT_LOG_TOOLS, AGENT_LOG_THINKING, AGENT_DEBUG_QUEUE, PI_PROVIDER, PI_MODEL, ANTHROPIC_BASE_URL, …
# If PI_PROVIDER is omitted, the app picks anthropic when only Anthropic keys exist (see index.ts).

# --- Provider (matches former config_example.json multi-provider setup, single active block) ---
PI_PROVIDER=anthropic
PI_MODEL=claude-opus-4-7
ANTHROPIC_AUTH_TOKEN=
# Optional: Anthropic-compatible proxy (e.g. Z.AI)
ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic

# OpenAI-style (if PI_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Optional overrides
# PI_SYSTEM_PROMPT=You are a helpful assistant. Use tools when they are useful.

# Verbose [TOOL CALL] / [TOOL RESULT] (default on). Does not affect model thinking. Disable with 0/false/no/off.
# AGENT_LOG_TOOLS=0

# Stream model thinking to stderr as 💭 [THINKING] … (default on). Separate from AGENT_LOG_TOOLS.
# AGENT_LOG_THINKING=0

# Verbose queue poller (default off). Set to 1 to log "Service busy, skip pick." while a task runs.
# AGENT_DEBUG_QUEUE=1

# Browser agent control plane HTTP API (started with npm run dev; disable with BROWSER_AGENT_API_ENABLED=0)
# BROWSER_AGENT_API_PORT=8791
# BROWSER_AGENT_API_KEY=
# Max concurrent AI test runs (default 1). Also accepts MAX_CONCURRENT_RUNS.
# BROWSER_AGENT_MAX_CONCURRENT=1

# Agent run wall-clock budget (ms). On expiry, screenshots + network are saved before status=error.
# TASK_TIMEOUT_MS=600000
# Max wait for in-flight shell + network save after agent budget (ms). Default 120000.
# TASK_FINALIZE_TIMEOUT_MS=120000

# Optional: path to JSON config instead of / in addition to env (see index.ts)
# PI_CONFIG=config/pi-agent.config.json
